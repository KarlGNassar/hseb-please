NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# First release: everyone can split at any restaurant, without Supabase setup.
# Set true to require a registered restaurant with active splitting access.
# Server-only: restart the app after changing this value.
HSEB_REQUIRE_REGISTERED_RESTAURANT=false

# Server-only OCR.Space key. Add this same variable in Vercel, then redeploy.
OCR_SPACE_API_KEY=your-ocr-space-api-key
